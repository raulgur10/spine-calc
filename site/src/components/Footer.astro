---
import { getLangFromUrl, useTranslations, pathFor } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="site-foot">
  <div class="container">
    <p class="foot-note">
      <Fragment set:html={t('foot.note')} />
      <a href={pathFor('disclaimer', lang)}>{t('foot.readDisclaimer')}</a>.
    </p>
    <div class="foot-links">
      <a href={pathFor('references', lang)}>{t('nav.references')}</a>
      <a href={pathFor('team', lang)}>{t('nav.team')}</a>
      <a href="https://vml.solutions/" target="_blank" rel="noopener">Virtual Medical Learning</a>
      <a href="https://github.com/raulgur10/spine-calc" target="_blank" rel="noopener">{t('foot.source')}</a>
    </div>
    <p class="foot-legal">{t('foot.legal')}</p>
    <button id="spine-easter-egg" class="spine-egg" type="button" aria-label={t('foot.eggAria')}>
      <svg width="20" height="22" viewBox="0 0 20 22" fill="currentColor" aria-hidden="true">
        <path d="M10 1.2 3.6 3.9v4.3L10 10.6l6.4-2.4V3.9L10 1.2z"/>
        <path d="M10 11.4 3.6 14.1v4.3L10 20.8l6.4-2.4v-4.3L10 11.4z"/>
      </svg>
    </button>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--c-footer);
    color: #c9c0ad;
    padding: 56px 0 40px;
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .foot-note { max-width: 80ch; }
  /* El <strong> llega por set:html, así que no lleva el hash de scope. */
  .foot-note :global(strong) { color: #f3efe6; }
  .foot-note a { color: #f3efe6; text-decoration: underline; }
  .foot-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin: 24px 0;
  }
  .foot-links a { color: #f3efe6; font-weight: 500; }
  .foot-legal { margin: 0; color: #9b927e; font-size: 0.85rem; }
  .spine-egg {
    display: block;
    margin: 18px 0 0 auto;
    padding: 6px;
    background: none;
    border: none;
    color: #9b927e;
    opacity: 0.45;
    cursor: pointer;
    line-height: 0;
    border-radius: 6px;
    transition: opacity 0.2s, color 0.2s, transform 0.2s;
  }
  .spine-egg:hover,
  .spine-egg:focus-visible {
    opacity: 0.9;
    color: #e6b980;
    transform: translateY(-2px);
    outline: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .spine-egg { transition: none; }
  }
</style>
