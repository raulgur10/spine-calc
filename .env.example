# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore (patrón *.local): nunca se commitea.

# ── Supabase ────────────────────────────────────────────────────────────────
# Ambos son públicos por diseño: viajan en el bundle del navegador. Lo que
# protege los datos es el RLS del esquema, no el secreto de estas dos cadenas.
# Panel de Supabase → Connect → Project URL / Publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NUNCA pongas aquí la cadena de conexión directa (postgresql://...) ni la
# secret key: llevan credenciales de administrador y este archivo se lee desde
# el navegador. Para migraciones usa la CLI de Supabase o el SQL Editor.

# ── Firebase (motor actual, se retira al terminar la migración) ─────────────
# Si se dejan vacías, la aplicación cae a los valores que hoy están en
# src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
