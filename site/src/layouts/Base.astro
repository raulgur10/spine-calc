---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '../styles/global.css';

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · SpineCalc` : 'SpineCalc';
const desc = description || 'SpineCalc — medición de alineación sagital espinopélvica. GAP score, Roussouly, SRS-Schwab y más.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://spinecalc.app').toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
