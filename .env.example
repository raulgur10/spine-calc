# Opcional. Solo las usa la encuesta de opinión anónima (src/feedback.js).
# SpineCalc no guarda casos, mediciones, imágenes ni cuentas: sin estas variables la
# calculadora funciona completa y simplemente no muestra la encuesta.
#
# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase
# (Dashboard → Project Settings → API). Son públicas por diseño: viajan en el bundle,
# y la tabla `feedback` solo admite inserciones (véase supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
