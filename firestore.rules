rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    function hasConsent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consentVersion != null;
    }

    // Allowlist: leer el propio documento para verificar autorización.
    // Escritura: solo vía consola Firebase (bloqueada desde la app).
    match /allowlist/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // Perfil de usuario: el propio usuario crea/actualiza su registro de consentimiento.
    match /users/{uid} {
      allow read, write: if isSignedIn()
        && request.auth.uid == uid
        && isAllowed();
    }

    // Casos: solo usuarios autorizados y con consentimiento.
    // Cada caso pertenece al ownerUid que lo creó.
    match /casos/{casoId} {
      allow read: if isSignedIn()
        && isAllowed()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isSignedIn()
        && isAllowed()
        && hasConsent()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email;

      allow update: if isSignedIn()
        && isAllowed()
        && hasConsent()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if isSignedIn()
        && isAllowed()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
